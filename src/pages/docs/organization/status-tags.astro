---
import DocsLayout from "@/layouts/DocsLayout.astro";
---

<DocsLayout title="Status & Tags">
  <h1>Status & tags</h1>
  <p class="muted">
    Writer can attach per-note metadata like status and tags, keyed by file path and stored locally.
  </p>

  <h2>How it shows up</h2>
  <ul>
    <li>Status and tag chips can appear in the file tree.</li>
    <li>These values are edited in the note header.</li>
  </ul>
</DocsLayout>

