---
import DocsLayout from "@/layouts/DocsLayout.astro";
---

<DocsLayout title="Settings">
  <h1>Settings</h1>
  <p class="muted">Customize the writing experience.</p>

  <h2>Appearance</h2>
  <ul>
    <li>Theme mode: light / dark / system</li>
    <li>Fonts and font sizes</li>
  </ul>

  <h2>Editor</h2>
  <ul>
    <li>Toolbar toggle</li>
    <li>Vim mode</li>
    <li>Relative line numbers</li>
    <li>Line wrapping</li>
    <li>Tab indent unit (spaces per tab)</li>
  </ul>

  <h2>AI</h2>
  <ul>
    <li>Store your OpenRouter API key locally in Settings.</li>
    <li>Use AI writing tools with note context to draft, rewrite, summarize, and improve text faster.</li>
  </ul>
</DocsLayout>
