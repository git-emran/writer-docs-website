---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { siteConfig } from "@/lib/site";
---

<SiteLayout title="Local-first Markdown notes">
  <section class="hero">
    <div class="container inner">
      <div class="eyebrow">Our perfect-fit</div>

      <h1 class="display">
        Local-first Markdown notes with Intuitive editing, freeform Canvas, Kanban board, and an
        embedded Terminal.
      </h1>

      <p class="lead">
        Writer keeps your notes as plain files under <code>~/Writer</code>. Write fast with Live
        Preview, preview or export to PDF, and organize work without leaving your notes workspace.
      </p>

      <div class="cta">
        <a class="btn primary" href="/docs/getting-started/installation">Read docs</a>
        <a class="btn" href={siteConfig.downloadUrl}>Download (macOS)</a>
      </div>

      <figure class="heroMedia">
        <div class="media">
          <img
            src="/assets/hero.png"
            width="1600"
            height="1400"
            loading="eager"
            decoding="async"
            alt="Writer editor showing file explorer and Markdown content"
          />
        </div>
        <figcaption class="muted">Live Preview editor with file explorer and note metadata.</figcaption>
      </figure>
    </div>
  </section>

  <section class="container section">
    <div class="sectionHead">
      <div>
        <div class="eyebrow">What drives us</div>
        <h2 class="headline">Why Writer</h2>
      </div>
    </div>
    <div class="prose">
      <p class="lead">
        Writer makes Markdown feel fast, natural, and easy to shape as you write. Intuitive commands
        keep formatting, structure, and navigation close at hand, so headings, lists, links, and tasks
        stay smooth instead of interrupting your flow. Built-in AI helps you draft, refine, and expand
        ideas faster with the context of your notes, while your files remain local and readable under
        <code>~/Writer</code>.
      </p>
      <ul class="muted">
        <li><strong>Local-first:</strong> your notes are real files on disk.</li>
        <li><strong>Organize beyond docs:</strong> Canvas for spatial thinking, Kanban for tasks.</li>
        <li><strong>Practical exports:</strong> export notes and canvases to PDF.</li>
        <li><strong>Customizable:</strong> theme, fonts, Vim mode, wrapping, line numbers.</li>
      </ul>
    </div>
  </section>

  <section class="container section">
    <div class="sectionHead">
      <div>
        <div class="eyebrow">Highlights</div>
        <h2 class="headline">Feature highlights</h2>
      </div>
    </div>
    <div class="grid featureList">
      <div class="card">
        <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
              <path d="M2.75 2.5A1.25 1.25 0 0 0 1.5 3.75v8.5A1.25 1.25 0 0 0 2.75 13.5h10.5A1.25 1.25 0 0 0 14.5 12.25v-6.5A1.25 1.25 0 0 0 13.25 4.5H8.8L7.5 3.1A1.25 1.25 0 0 0 6.6 2.5H2.75Z"/>
            </svg>
        </div>
        <h3 class="cardTitle">Editor + Live Preview</h3>
        <p class="muted small">CodeMirror-based editor with inline rendering behavior inspired by Obsidian.</p>
      </div>
      <div class="card">
        <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
              <path d="M2.5 3.75A1.25 1.25 0 0 1 3.75 2.5h8.5A1.25 1.25 0 0 1 13.5 3.75v8.5a1.25 1.25 0 0 1-1.25 1.25h-8.5A1.25 1.25 0 0 1 2.5 12.25v-8.5Zm3.25.25a.75.75 0 0 0 0 1.5h5.5a.75.75 0 0 0 0-1.5h-5.5ZM5 7.25a.75.75 0 0 1 .75-.75h5.5a.75.75 0 0 1 0 1.5h-5.5A.75.75 0 0 1 5 7.25ZM5.75 9a.75.75 0 0 0 0 1.5h3.5a.75.75 0 0 0 0-1.5h-3.5Z"/>
            </svg>
        </div>
        <h3 class="cardTitle">Preview + split view</h3>
        <p class="muted small">Full preview and side-by-side split view with scroll sync.</p>
      </div>
      <div class="card">
        <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
              <path d="M2.75 2.5A1.25 1.25 0 0 0 1.5 3.75v8.5A1.25 1.25 0 0 0 2.75 13.5h10.5A1.25 1.25 0 0 0 14.5 12.25v-8.5A1.25 1.25 0 0 0 13.25 2.5H2.75Zm.25 1.25a.25.25 0 0 1 .25-.25h2.5v9H3.25a.25.25 0 0 1-.25-.25v-8.5Zm3.75-.25h6.5a.25.25 0 0 1 .25.25v8.5a.25.25 0 0 1-.25.25h-6.5v-9Z"/>
            </svg>
        </div>
        <h3 class="cardTitle">Canvas, Kanban, Terminal</h3>
        <p class="muted small">Canvas files in your vault, Kanban boards in local storage, and a real shell tab.</p>
      </div>
      <div class="card">
        <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
              <path d="M4.75 1.5A1.25 1.25 0 0 0 3.5 2.75v10.5c0 .69.56 1.25 1.25 1.25h6.5c.69 0 1.25-.56 1.25-1.25V5.75a1.25 1.25 0 0 0-.366-.884L9.634 2.366A1.25 1.25 0 0 0 8.75 2h-4Zm0 1.5h3.5v2.25c0 .69.56 1.25 1.25 1.25H11v6.75a.25.25 0 0 1-.25.25h-6.5a.25.25 0 0 1-.25-.25V2.75a.25.25 0 0 1 .25-.25Z"/>
            </svg>
        </div>
        <h3 class="cardTitle">Export to PDF & CSV</h3>
        <p class="muted small">Export Markdown notes canvases to PDF and Spreadsheets to CSV.</p>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="sectionHead">
      <div>
        <div class="eyebrow">Questions</div>
        <h2 class="headline">FAQ</h2>
      </div>
    </div>
    <div class="faq">
      <details class="faqItem">
        <summary>Where are my notes stored?</summary>
        <div class="faqBody muted tiny">By default, in <code>~/Writer</code> as normal files.</div>
      </details>
      <details class="faqItem">
        <summary>Is there any cloud sync?</summary>
        <div class="faqBody muted tiny">
          No forced cloud. Use iCloud/Dropbox/Git/your preferred sync if you want. Since there is a single folder that the app uses as a vault, it is easier to version control your notes.
        </div>
      </details>
      <details class="faqItem">
        <summary>Does it run on Windows/Linux?</summary>
        <div class="faqBody muted tiny">
          Currently distributed for macOS and Linux, but anyone can build the app in their windows machine.
        </div>
      </details>
      <details class="faqItem">
        <summary>Can I export to PDF?</summary>
        <div class="faqBody muted tiny">Yes, you can easily export notes and canvases to PDF and even spreadsheets to CSV files.</div>
      </details>
    </div>
  </section>
</SiteLayout>

<script is:inline>
  // Accordion behavior: keep only one FAQ open at a time.
  document.addEventListener("DOMContentLoaded", () => {
    const items = Array.from(document.querySelectorAll("details.faqItem"));
    for (const item of items) {
      item.addEventListener("toggle", () => {
        if (!item.open) return;
        for (const other of items) {
          if (other !== item) other.open = false;
        }
      });
    }
  });
</script>

<style>
  .hero {
    padding: clamp(56px, 7vw, 92px) 0 10px;
  }
  .inner {
    display: grid;
    gap: 18px;
  }
  .cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .heroMedia {
    margin: 14px 0 0;
  }
  .media {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface-2);
    width: fit-content,
    overflow: hidden;
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow);
  }
  .heroMedia img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center top;
    display: block;
  }
  .heroMedia figcaption {
    margin-top: 10px;
    font-size: 13px;
  }
  .prose {
    max-width: 80ch;
    display: grid;
    gap: 12px;
  }
  .prose ul {
    margin: 0;
    padding-left: 18px;
  }
  .sectionHead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 26px;
  }
  .featureList {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .faq {
    max-width: 80ch;
    display: grid;
    gap: 10px;
  }
  .faqItem {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface-2);
    padding: 12px 14px;
    box-shadow: var(--shadow-sm);
  }
  summary {
    cursor: pointer;
    list-style: none;
    font-size: 14px;
    font-weight: 750;
    letter-spacing: -0.02em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faqBody {
    margin-top: 8px;
  }
  .cardTitle {
    margin: 12px 0 6px;
    font-size: 16px;
    font-weight: 820;
    letter-spacing: -0.02em;
  }
  .icon {
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in oklab, var(--accent) 7%, var(--surface-2));
    color: color-mix(in oklab, var(--accent) 70%, var(--text));
    flex: 0 0 auto;
  }
  .privacy ul {
    margin: 10px 0 0;
    padding-left: 18px;
  }
  @media (max-width: 860px) {
    .featureList {
      grid-template-columns: 1fr;
    }
  }
</style>
