---
import BaseHead from "@/components/BaseHead.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { DOCS_NAV, findNavItemByHref } from "@/lib/docs/nav";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const { title, description } = Astro.props;
const currentHref = Astro.url.pathname.replace(/\/$/, "");
const currentItem = findNavItemByHref(currentHref);
const pageTitle = title ?? currentItem?.title ?? "Docs";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={description} />
  </head>
  <body>
    <SiteHeader />
    <div class="container docsShell">
      <aside class="sidebar" aria-label="Docs navigation">
        <div class="sidebarInner">
          <div class="sidebarTitle">Documentation</div>
          {DOCS_NAV.map((section) => (
            <div class="section">
              <div class="sectionTitle">{section.title}</div>
              <div class="items">
                {section.items.map((item) => (
                  <a
                    class:list={["item", item.href === currentHref && "active"]}
                    href={item.href}
                  >
                    {item.title}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </aside>
      <div class="content">
        <div class="contentInner">
          <slot />
        </div>
      </div>
    </div>
    <SiteFooter />
  </body>
</html>

<style>
  .docsShell {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    padding-top: 24px;
  }

  .sidebar {
    position: sticky;
    top: 84px;
    height: calc(100dvh - 110px);
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .sidebarInner {
    padding: 8px 10px 10px;
    height: 100%;
    overflow: auto;
    scrollbar-width: none; /* Firefox */
  }

  .sidebarInner::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .sidebarTitle {
    font-weight: 750;
    margin: 6px 6px 10px;
    letter-spacing: -0.01em;
    color: var(--muted);
    font-size: 13px;
  }

  .section {
    margin-top: 10px;
    padding-top: 10px;
  }

  .section:first-of-type {
    margin-top: 0;
    padding-top: 0;
  }

  .sectionTitle {
    font-size: 12px;
    text-transform: none;
    letter-spacing: -0.01em;
    color: var(--muted);
    margin: 0 6px 8px;
    font-weight: 650;
  }

  .items {
    display: grid;
    gap: 1px;
  }

  .item {
    padding: 8px 10px;
    border-radius: 14px;
    border: 1px solid transparent;
    color: color-mix(in oklab, var(--text) 86%, var(--muted));
    font-weight: 650;
    font-size: 14px;
    line-height: 1.2;
  }

  .item:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .active {
    color: var(--text);
    border-color: color-mix(in oklab, var(--text) 14%, transparent);
    background: color-mix(in oklab, var(--text) 8%, var(--surface-2));
  }

  .contentInner {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 28px;
  }

  .content :global(h1) {
    margin: 0 0 10px;
    font-size: 34px;
    letter-spacing: -0.02em;
  }

  .content :global(h2) {
    margin-top: 26px;
    font-size: 20px;
  }

  .content :global(p) {
    margin: 10px 0;
  }

  .content :global(ul) {
    padding-left: 18px;
  }

  .content :global(pre) {
    padding: 14px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    overflow: auto;
  }

  .content :global(code) {
    font-size: 0.95em;
  }

  .content :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--link) 40%, transparent);
    text-underline-offset: 2px;
  }

  @media (max-width: 980px) {
    .docsShell {
      grid-template-columns: 1fr;
    }
    .sidebar {
      position: relative;
      top: 0;
      height: auto;
      overflow: visible;
    }
    .sidebarInner {
      height: auto;
      overflow: visible;
    }
  }
</style>
